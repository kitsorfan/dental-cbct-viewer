{
  "name": "dental-cbct-viewer",
  "version": "1.4.1",
  "description": "Dental CBCT viewer that runs entirely in the browser: panoramic, cross-sections, 3D, measurements and PDF reports.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/serve.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
